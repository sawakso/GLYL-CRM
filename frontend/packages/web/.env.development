VITE_API_BASE_URL='front'
VITE_DEV_DOMAIN='http://127.0.0.1:8081'
# Vite dev server 允许的 Host 白名单（逗号分隔，支持 .域 子域名通配，* 表示允许所有）。
# - 本机开发：留空即可（默认放行 localhost / 127.0.0.1）
# - 公网穿透 / 局域网访问：在 .env.development.local 里覆盖，例如
#   VITE_ALLOWED_HOSTS='crm.sawakso.com,.sawakso.com'
VITE_ALLOWED_HOSTS=''
# 市场表单二维码公开链接基础地址 (指向移动端站点)。
# 开发环境: 移动端 Vite dev server (端口 3000, base=/mobile/)
# 注意: 如需手机扫码测试, 把 127.0.0.1 改为你电脑的局域网 IP
VITE_PUBLIC_FORM_BASE_URL='http://127.0.0.1:3000'
# 生产环境
# VITE_PUBLIC_FORM_BASE_URL='https://crm.sawakso.com/mobile/'
