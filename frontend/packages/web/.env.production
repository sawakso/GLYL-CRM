# 生产 API 前缀：构建后所有接口请求统一走 /api，由 Nginx 剥离前缀转发后端(8081)。
# Nginx 示例:
#   location /api/  { proxy_pass http://127.0.0.1:8081/; }   # 末尾 / 会剥离 /api
#   location /sse/  { proxy_pass http://127.0.0.1:8081; proxy_buffering off; proxy_read_timeout 3600s; }
VITE_API_BASE_URL='/api'
# 市场表单二维码公开链接基础地址 (指向移动端站点)。
# 留空自动使用当前访问域名 (window.location.origin)，适配任何部署环境
VITE_PUBLIC_FORM_BASE_URL=''
