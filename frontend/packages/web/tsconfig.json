{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*",
    "types/**/*",
    "config/**/*.ts",
    "*.d.ts",
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "paths": {
      // 路径映射
      "@/*": [
        "./src/*"
      ],
      "#/*": [
        "types/*"
      ],
    },
  },
}