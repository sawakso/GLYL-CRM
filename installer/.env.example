# 复制为 installer/.env 后，替换下面所有 CHANGE_ME 值。
# installer/.env 已被仓库根目录的 .gitignore 忽略，不要提交真实密码。
FXIAOKE_MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
FXIAOKE_MYSQL_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
FXIAOKE_REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
FXIAOKE_CORDYS_SECRET_KEY=CHANGE_ME_RANDOM_32_CHAR_SECRET
